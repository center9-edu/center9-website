# Copy to .env.local and fill in the real values. Never commit .env.local.

# Google Apps Script web app that appends trial registrations to the Google Sheet.
# See docs/trial-registration-google-sheet.md.
GOOGLE_SHEETS_WEBHOOK_URL=
# Shared secret; must match the WEBHOOK_SECRET script property in Apps Script.
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Slack incoming webhook for new trial registration notifications (channel #crm).
SLACK_WEBHOOK_URL=
